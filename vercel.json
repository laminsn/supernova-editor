{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/generate-strategy.js":       { "maxDuration": 300 },
    "api/generate-strategy-quick.js": { "maxDuration": 300 },
    "api/generate-carousel.js":       { "maxDuration": 120 }
  },
  "ignoreCommand": "bash scripts/v41-health-check.sh",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/booking-reminder-cron",
      "schedule": "*/15 * * * *"
    }
  ]
}
